---
import '../styles/global.css';
import jaFonts from '@fontsource-variable/noto-sans-jp/index.css?url';
import koFonts from '@fontsource-variable/noto-sans-kr/index.css?url';
import zhFonts from '@fontsource-variable/noto-sans-sc/index.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, htmlLang, t, localize, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path after the language prefix, used for the language switcher and hreflang. */
  path?: string;
}
const { lang, title, description, path = '' } = Astro.props;
const s = t(lang);
const noindex = (import.meta.env.PUBLIC_NOINDEX ?? 'true') !== 'false';
const site = Astro.site ?? new URL('https://goodandwell.pages.dev');
const canonical = new URL(localize(lang, path), site).href;
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localize(l, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localize('en', path), site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={s.meta.siteName} />
    <meta name="theme-color" content="#0E1B2E" />
    {lang === 'ja' && <link rel="stylesheet" href={jaFonts} />}
    {lang === 'ko' && <link rel="stylesheet" href={koFonts} />}
    {lang === 'zh' && <link rel="stylesheet" href={zhFonts} />}
  </head>
  <body class="min-h-dvh bg-paper text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-card focus:px-4 focus:py-3">{s.nav.skip}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
