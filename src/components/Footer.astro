---
import Text from './Text.astro';
import { t, localize, company, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---
<footer class="bg-ink text-ink-muted">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl font-bold text-white">Good<span class="text-ink-accent">&amp;</span>Well</p>
      <p class="mt-3 text-sm leading-relaxed">
        {s.contact.office.company}<br />
        {company.address}
      </p>
      <p class="mt-3 text-sm">
        {s.contact.tel} <a class="hover:text-white" href={`tel:${company.tel.replace(/-/g, '')}`}>{company.tel}</a>
        <span class="mx-2 text-ink-muted/50">/</span>
        {s.contact.fax} {company.fax}
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{s.contact.person.title}</p>
      <p class="mt-3 text-sm leading-relaxed">
        {s.contact.person.name}, {s.contact.person.role}<br />
        <a class="hover:text-white" href={`mailto:${company.contactEmail}`}>{company.contactEmail}</a><br />
        <a class="hover:text-white" href={`tel:${company.contactMobile.replace(/-/g, '')}`}>{company.contactMobile}</a>
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{s.footer.brands}</p>
      <ul class="mt-3 space-y-1 text-sm">
        {company.brands.map((b) => <li>{b}</li>)}
      </ul>
      <ul class="mt-6 space-y-1 text-sm">
        <li><a class="hover:text-white" href={localize(lang, 'products/')}>{s.nav.products}</a></li>
        <li><a class="hover:text-white" href={localize(lang, 'factory/')}>{s.nav.factory}</a></li>
        <li><a class="hover:text-white" href={localize(lang, 'about/')}>{s.nav.about}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-5 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Jaewon Global Net. All rights reserved.</p>
      <p><Text text={s.footer.notice} /></p>
    </div>
  </div>
</footer>
