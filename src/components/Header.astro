---
import LangSwitch from './LangSwitch.astro';
import { t, localize, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const s = t(lang);
const home = localize(lang);
// OEM, News and Contact point to Home sections until their own pages are built.
const items = [
  { href: localize(lang, 'products/'), label: s.nav.products, key: 'products' },
  { href: localize(lang, 'factory/'), label: s.nav.factory, key: 'factory' },
  { href: `${home}#oem`, label: s.nav.oem, key: 'oem' },
  { href: localize(lang, 'about/'), label: s.nav.about, key: 'about' },
  { href: `${home}#news`, label: s.nav.news, key: 'news' },
];
const current = path.split('/')[0];
---
<header class="sticky top-0 z-40 border-b border-line bg-card/95 backdrop-blur supports-[backdrop-filter]:bg-card/85">
  <div class="container-x flex h-16 items-center justify-between gap-2">
    <a href={home} class="flex min-h-11 shrink-0 items-center no-underline">
      <img src="/brand/goodandwell.svg" alt="Good&Well" width="139" height="34" class="h-7 w-auto sm:h-[34px]" />
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Main">
      {items.map((i) => (
        <a
          href={i.href}
          class:list={[
            'inline-flex min-h-11 items-center rounded px-3 text-[0.9375rem] font-medium no-underline hover:text-brand',
            current === i.key ? 'text-brand' : 'text-ink',
          ]}
          aria-current={current === i.key ? 'page' : undefined}
        >{i.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <LangSwitch lang={lang} path={path} />
      <a href={`${home}#contact`} class="btn btn-primary hidden md:inline-flex">{s.nav.contact}</a>

      <details class="group relative xl:hidden">
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 rounded border border-line px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
          <span>{s.nav.menu}</span>
          <svg class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.75"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-[min(18rem,calc(100vw-2rem))] rounded-md border border-line bg-card p-2 shadow-lg">
          <nav aria-label="Main mobile">
            <ul>
              {[...items, { href: `${home}#contact`, label: s.nav.contact, key: 'contact' }].map((i) => (
                <li><a href={i.href} class="flex min-h-11 items-center rounded px-3 font-medium no-underline hover:bg-paper">{i.label}</a></li>
              ))}
            </ul>
          </nav>

        </div>
      </details>
    </div>
  </div>
</header>
<script>
  // Close menus after choosing a link, when clicking elsewhere, or on Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('header details')];
  menus.forEach((d) => {
    d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => d.removeAttribute('open')));
    d.addEventListener('toggle', () => { if (d.open) menus.forEach((o) => o !== d && o.removeAttribute('open')); });
  });
  document.addEventListener('click', (e) => menus.forEach((d) => { if (!d.contains(e.target as Node)) d.removeAttribute('open'); }));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') menus.forEach((d) => d.removeAttribute('open')); });
</script>
