---
// Language menu. Each language is named the way its own speakers write it, without flags or
// country names (Chinese is offered by script: 简体中文 / 繁體中文).
import { languages, langs, htmlLang, localize, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
---
<details class="group/lang relative" data-lang-switch>
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded px-2.5 text-sm font-semibold text-ink hover:text-brand [&::-webkit-details-marker]:hidden"
    aria-label={`${t(lang).nav.language}: ${languages[lang]}`}
  >
    <svg class="size-[18px] text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="10" cy="10" r="7.5" /><path d="M2.5 10h15M10 2.5c2.2 2.3 3.2 4.8 3.2 7.5s-1 5.2-3.2 7.5M10 2.5C7.8 4.8 6.8 7.3 6.8 10s1 5.2 3.2 7.5" />
    </svg>
    <span lang={htmlLang[lang]}>{languages[lang]}</span>
    <svg class="size-3.5 transition-transform group-open/lang:rotate-180" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
  </summary>
  <ul class="absolute right-0 z-50 mt-2 w-44 rounded-md border border-line bg-card p-1.5 shadow-lg">
    {langs.map((l) => (
      <li>
        <a
          href={localize(l, path)}
          hreflang={htmlLang[l]}
          lang={htmlLang[l]}
          class:list={['flex min-h-11 items-center justify-between rounded px-3 text-[0.9375rem] no-underline hover:bg-paper', l === lang ? 'font-semibold text-brand' : 'text-ink']}
          aria-current={l === lang ? 'true' : undefined}
        >
          {languages[l]}
          {l === lang && <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>}
        </a>
      </li>
    ))}
  </ul>
</details>
