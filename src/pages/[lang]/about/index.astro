---
import Base from '../../../layouts/Base.astro';
import Text from '../../../components/Text.astro';
import SectionHead from '../../../components/SectionHead.astro';
import { langs, t, localize, company, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
const a = s.aboutPage;
// ISO 9001 (2012) is left out of the history until the certificate is confirmed as current.
---
<Base lang={lang} title={`${s.meta.about} | Good&Well`} description={s.meta.aboutDescription} path="about/">
  <section class="border-b border-line bg-card">
    <div class="container-x py-12 sm:py-16">
      <p class="eyebrow">About</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{a.title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink">{a.lead}</p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div class="space-y-4 leading-relaxed text-muted">
        {a.intro.map((para) => <p><Text text={para} /></p>)}
      </div>
      <div>
        <h2 class="text-lg font-bold">{a.factsTitle}</h2>
        <dl class="mt-4 divide-y divide-line rounded-lg border border-line bg-card text-sm">
          {a.facts.map((f) => (
            <div class="grid grid-cols-[7rem_1fr] gap-3 p-4">
              <dt class="text-muted">{f.k}</dt>
              <dd class="font-medium"><Text text={f.v} /></dd>
            </div>
          ))}
          <div class="grid grid-cols-[7rem_1fr] gap-3 p-4">
            <dt class="text-muted">{s.contact.office.title}</dt>
            <dd class="font-medium">{lang === 'ko' ? company.addressKo : company.address}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-card py-12 sm:py-16" aria-labelledby="history-title">
    <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <SectionHead id="history-title" title={a.historyTitle} />
      </div>
      <ol class="border-l-2 border-line">
        {a.history.map((h) => (
          <li class="relative pb-6 pl-6 last:pb-0">
            <span class="absolute -left-[7px] top-1.5 size-3 rounded-full border-2 border-brand bg-card" aria-hidden="true"></span>
            <p class="font-display text-sm font-semibold text-brand">{h.date}</p>
            <p class="mt-0.5">{h.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-12 sm:py-16" aria-labelledby="brands-title">
    <div class="container-x">
      <SectionHead id="brands-title" title={a.brandsTitle} />
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {a.brands.map((b) => (
          <li class="flex flex-col rounded-lg border border-line bg-card">
            <div class="flex aspect-[5/2] items-center justify-center rounded-t-lg bg-photo p-4 text-center text-xs">
              <Text text={a.logoPending} />
            </div>
            <div class="p-5">
              <h3 class="text-xl font-bold">{b.name}</h3>
              <p class="text-sm text-muted">{b.sub}</p>
              <p class="mt-3 text-sm leading-relaxed"><Text text={b.body} /></p>
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={`${localize(lang)}#contact`} class="btn btn-primary">{s.nav.contact}</a>
        <a href={localize(lang, 'factory/')} class="btn btn-outline">{s.nav.factory}</a>
      </div>
    </div>
  </section>
</Base>
